// Live site. Separate file rather than an env in wrangler.jsonc because "assets" is an
// inheritable key — a named env would inherit ./dist, and assets are served ahead of the
// Worker script, so coming-soon.js would never run.
{
  "name": "xenia-nessuvia",
  // Still the coming-soon page. Becoming src/index.js is also when this config needs an "assets"
  // block.
  "main": "src/coming-soon.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  // custom_domain (not a route pattern): wrangler creates the proxied DNS records itself. A plain
  // route needs a record to already exist in the zone, which is why the apex 404'd at DNS.
  "routes": [
    { "pattern": "nessuvia.com", "custom_domain": true },
    { "pattern": "www.nessuvia.com", "custom_domain": true }
  ]
}
